# Copie para .env e gere novos valores fortes antes de iniciar.
POSTGRES_DB=cashlojas
POSTGRES_USER=cashlojas
POSTGRES_PASSWORD=ReplaceWithUniqueDbPass123
DATABASE_URL=postgresql://cashlojas:ReplaceWithUniqueDbPass123@localhost:5432/cashlojas?schema=public

# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=cashlojas-api
REFRESH_TOKEN_TTL_DAYS=7

# A conta ROOT é criada automaticamente ao iniciar a API pela primeira vez.
SEED_ROOT_EMAIL=root@cashlojas.local
SEED_ROOT_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD_Aa1!

NODE_ENV=development
PORT=3000
WEB_PORT=8080
# URL pública do frontend usada no link de boas-vindas enviado por WhatsApp (em produção: https://seu-dominio)
APP_PUBLIC_URL=http://localhost:5173
ACTIVATION_TTL_HOURS=168
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BUSINESS_UTC_OFFSET=-03:00

# Modo local: log (mensagens simuladas; nenhum WhatsApp é enviado)
WHATSAPP_PROVIDER=log
# Produção: Meta WhatsApp Cloud API. Requer templates aprovados na Meta.
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_API_VERSION=v21.0
WHATSAPP_META_TEMPLATE_PURCHASE=
WHATSAPP_META_TEMPLATE_REDEMPTION=
WHATSAPP_META_TEMPLATE_WELCOME=
WHATSAPP_META_TEMPLATE_LANG=pt_BR

# WAHA (WhatsApp HTTP API auto-hospedada na VPS) — opção de menor custo para o MVP.
# Envia texto livre pela sessão conectada; não exige templates aprovados.
# Após preencher a chave, troque WHATSAPP_PROVIDER (acima) para "waha" para ativar o envio real.
WHATSAPP_WAHA_BASE_URL=https://apiwa.topago.com.br
WHATSAPP_WAHA_API_KEY=
WHATSAPP_WAHA_SESSION=default

# Opcional: popula dados de demonstração com backend/prisma/seed.ts (somente desenvolvimento)
SEED_DEMO=false
SEED_DEMO_PASSWORD=
