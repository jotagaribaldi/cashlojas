generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ROOT
  MANAGER
  CASHIER
  CUSTOMER
  SINDICO
  ADMINISTRADORA
}

enum CreditStatus {
  ACTIVE
  CONSUMED
  EXPIRED
}

enum CreditSource {
  PURCHASE
  SIGNUP_BONUS
}

enum CommissionStatus {
  PENDING
  PAID
}

enum RedemptionRequestStatus {
  OPEN
  ATTENDED
  CANCELLED
}

enum RedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Group {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(80)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stores    Store[]

  @@map("groups")
}

model Store {
  id                  String              @id @default(uuid()) @db.Uuid
  groupId             String              @db.Uuid
  name                String              @db.VarChar(120)
  segment             String              @db.VarChar(120)
  cnpj                String?             @unique @db.VarChar(14)
  cashbackPercentBps  Int                 @default(500)
  signupBonusCents    Int                 @default(0)
  validityDays        Int                 @default(90)
  maxRedeemPercentBps Int                 @default(10000)
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  group               Group               @relation(fields: [groupId], references: [id], onDelete: Restrict)
  users               User[]
  enrollments         CustomerStore[]
  purchases           Purchase[]
  credits             CashbackCredit[]
  redemptions         Redemption[]
  redemptionRequests  RedemptionRequest[]
  commissions         ReferralCommission[]

  @@index([groupId])
  @@map("stores")
}

model User {
  id                   String         @id @default(uuid()) @db.Uuid
  name                 String         @db.VarChar(120)
  email                String         @unique @db.VarChar(160)
  passwordHash         String
  role                 Role
  storeId              String?        @db.Uuid
  active               Boolean        @default(true)
  failedLoginAttempts  Int            @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime       @default(now())
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  store                Store?         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer             Customer?
  refreshTokens        RefreshToken[]
  purchasesRegistered  Purchase[]     @relation("PurchaseCashier")
  redemptionsRequested Redemption[]   @relation("RedemptionCashier")
  redemptionsApproved  Redemption[]   @relation("RedemptionManager")
  commissionsPaid      ReferralCommission[] @relation("CommissionPaidBy")
  auditLogs            AuditLog[]
  sindicoVinculos      SindicoVinculo[]
  administradoraVinculo AdministradoraUser?
  activationTokens     ActivationToken[]

  @@index([storeId])
  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  familyId          String    @db.Uuid
  tokenHash         String    @unique
  passwordChangedAt DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedBy        String?   @db.Uuid
  userAgent         String?   @db.VarChar(255)
  ip                String?   @db.VarChar(64)
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Customer {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String?             @unique @db.Uuid
  name               String              @db.VarChar(120)
  phone              String              @unique @db.VarChar(15)
  cpf                String?             @unique @db.VarChar(11)
  rg                 String              @db.VarChar(20)
  email              String              @unique @db.VarChar(160)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  enrollments        CustomerStore[]
  purchases          Purchase[]
  credits            CashbackCredit[]
  redemptions        Redemption[]
  notifications      Notification[]
  activationTokens   ActivationToken[]
  redemptionRequests RedemptionRequest[]
  referrals          Purchase[]          @relation("PurchaseReferrer")
  commissions        ReferralCommission[]
  moradia            Moradia?

  @@map("customers")
}

model ActivationToken {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String?   @db.Uuid
  userId     String?   @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([userId])
  @@map("activation_tokens")
}

model CustomerStore {
  customerId           String   @db.Uuid
  storeId              String   @db.Uuid
  enrolledAt           DateTime @default(now())
  isProfessional       Boolean  @default(false)
  profession           String?  @db.VarChar(80)
  commissionPercentBps Int      @default(0)
  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([customerId, storeId])
  @@index([storeId])
  @@map("customer_stores")
}

model Purchase {
  id             String          @id @default(uuid()) @db.Uuid
  storeId        String          @db.Uuid
  customerId     String          @db.Uuid
  cashierId      String          @db.Uuid
  referrerCustomerId String?     @db.Uuid
  fiscalDocument String          @db.VarChar(60)
  amountCents    Int
  cashbackCents  Int
  purchaseDate   DateTime        @db.Date
  createdAt      DateTime        @default(now())
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  referrer       Customer?       @relation("PurchaseReferrer", fields: [referrerCustomerId], references: [id], onDelete: SetNull)
  cashier        User            @relation("PurchaseCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  credit         CashbackCredit?
  commission     ReferralCommission?

  @@unique([storeId, fiscalDocument])
  @@index([customerId, storeId, purchaseDate, amountCents])
  @@index([referrerCustomerId])
  @@map("purchases")
}

model CashbackCredit {
  id             String           @id @default(uuid()) @db.Uuid
  purchaseId     String?          @unique @db.Uuid
  customerId     String           @db.Uuid
  storeId        String           @db.Uuid
  source         CreditSource     @default(PURCHASE)
  signupBonusKey String?          @unique @db.VarChar(80)
  amountCents    Int
  remainingCents Int
  earnedAt       DateTime         @default(now())
  expiresAt      DateTime
  status         CreditStatus     @default(ACTIVE)
  purchase       Purchase?        @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  allocations    RedemptionItem[]

  @@index([customerId, storeId, status, expiresAt])
  @@map("cashback_credits")
}

model Redemption {
  id                  String           @id @default(uuid()) @db.Uuid
  storeId             String           @db.Uuid
  customerId          String           @db.Uuid
  cashierId           String           @db.Uuid
  managerId           String?          @db.Uuid
  fiscalDocument      String           @db.VarChar(60)
  purchaseAmountCents Int
  discountCents       Int
  status              RedemptionStatus @default(PENDING)
  authorizationCode   String?          @unique @db.VarChar(20)
  decisionNote        String?          @db.VarChar(255)
  decidedAt           DateTime?
  createdAt           DateTime         @default(now())
  store               Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer            Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cashier             User             @relation("RedemptionCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  manager             User?            @relation("RedemptionManager", fields: [managerId], references: [id], onDelete: Restrict)
  items               RedemptionItem[]

  @@index([storeId, status])
  @@index([customerId])
  @@map("redemptions")
}

model RedemptionItem {
  redemptionId String         @db.Uuid
  creditId     String         @db.Uuid
  amountCents  Int
  redemption   Redemption     @relation(fields: [redemptionId], references: [id], onDelete: Cascade)
  credit       CashbackCredit @relation(fields: [creditId], references: [id], onDelete: Restrict)

  @@id([redemptionId, creditId])
  @@map("redemption_items")
}

model Notification {
  id         String             @id @default(uuid()) @db.Uuid
  customerId String             @db.Uuid
  channel    String             @default("WHATSAPP") @db.VarChar(20)
  to         String             @db.VarChar(255)
  body       String
  status     NotificationStatus @default(PENDING)
  error      String?
  providerId String?            @db.VarChar(120)
  createdAt  DateTime           @default(now())
  sentAt     DateTime?
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  role       String?  @db.VarChar(20)
  storeId    String?  @db.Uuid
  action     String   @db.VarChar(80)
  entity     String   @db.VarChar(60)
  entityId   String?  @db.VarChar(60)
  outcome    String   @default("SUCCESS") @db.VarChar(20)
  method     String?  @db.VarChar(10)
  path       String?  @db.VarChar(255)
  statusCode Int?
  durationMs Int?
  error      String?  @db.VarChar(500)
  metadata   Json?
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(255)
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([outcome, createdAt])
  @@index([storeId, createdAt])
  @@map("audit_logs")
}

model ReferralCommission {
  id                     String           @id @default(uuid()) @db.Uuid
  purchaseId             String           @unique @db.Uuid
  storeId                String           @db.Uuid
  professionalCustomerId String           @db.Uuid
  amountCents            Int
  percentBps             Int
  status                 CommissionStatus @default(PENDING)
  paidAt                 DateTime?
  paidByUserId           String?          @db.Uuid
  createdAt              DateTime         @default(now())
  purchase               Purchase         @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  store                  Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  professional           Customer         @relation(fields: [professionalCustomerId], references: [id], onDelete: Restrict)
  paidBy                 User?            @relation("CommissionPaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)

  @@index([storeId, status])
  @@index([professionalCustomerId])
  @@map("referral_commissions")
}

model RedemptionRequest {
  id         String                  @id @default(uuid()) @db.Uuid
  customerId String                  @db.Uuid
  storeId    String                  @db.Uuid
  status     RedemptionRequestStatus @default(OPEN)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  customer   Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store      Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([customerId])
  @@map("redemption_requests")
}
model Administradora {
  id        String   @id @default(uuid()) @db.Uuid
  cnpj      String   @unique @db.VarChar(14)
  name      String   @db.VarChar(160)
  email     String   @db.VarChar(160)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  condominios Condominio[]
  users       AdministradoraUser[]

  @@map("administradoras")
}

model Condominio {
  id                   String   @id @default(uuid()) @db.Uuid
  cnpj                 String   @unique @db.VarChar(14)
  name                 String   @db.VarChar(160)
  administradoraId     String   @db.Uuid
  commissionPercentBps Int      @default(2000)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  administradora       Administradora @relation(fields: [administradoraId], references: [id], onDelete: Restrict)
  unidades             Unidade[]
  sindicos             SindicoVinculo[]
  moradias             Moradia[]

  @@index([administradoraId])
  @@map("condominios")
}

model Unidade {
  id           String     @id @default(uuid()) @db.Uuid
  condominioId String     @db.Uuid
  label        String     @db.VarChar(40)
  createdAt    DateTime   @default(now())
  condominio   Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  moradias     Moradia[]

  @@unique([condominioId, label])
  @@map("unidades")
}

model Moradia {
  id           String     @id @default(uuid()) @db.Uuid
  customerId   String     @unique @db.Uuid
  condominioId String     @db.Uuid
  unidadeId    String     @db.Uuid
  startedAt    DateTime   @default(now())
  endedAt      DateTime?
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  condominio   Condominio @relation(fields: [condominioId], references: [id], onDelete: Restrict)
  unidade      Unidade    @relation(fields: [unidadeId], references: [id], onDelete: Restrict)

  @@index([condominioId])
  @@index([unidadeId])
  @@map("moradias")
}

model SindicoVinculo {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  condominioId String     @db.Uuid
  startedAt    DateTime   @default(now())
  endedAt      DateTime?
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  condominio   Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)

  @@unique([userId, condominioId])
  @@index([condominioId])
  @@map("sindico_vinculos")
}

model AdministradoraUser {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @unique @db.Uuid
  administradoraId String        @db.Uuid
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  administradora  Administradora @relation(fields: [administradoraId], references: [id], onDelete: Cascade)

  @@index([administradoraId])
  @@map("administradora_users")
}
